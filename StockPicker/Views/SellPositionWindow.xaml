<Window x:Class="StockPicker.Views.SellPositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sell Position"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="18,6" Margin="0,0,8,0" />
            <Button Content="Sell"   Click="Sell_Click" IsDefault="True" Padding="18,6" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Symbol"      Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SymbolText" VerticalAlignment="Center"
                       FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Shares"      Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SharesText" VerticalAlignment="Center"
                       Margin="0,0,0,8" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sell price"  Style="{StaticResource FieldLabel}" />
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PriceBox"
                       TextChanged="PriceBox_TextChanged"
                       ToolTip="Price per share you're selling at (defaults to the latest price)." />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Sell date"   Style="{StaticResource FieldLabel}" />
            <DatePicker Grid.Row="3" Grid.Column="1" x:Name="SellDatePicker" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Proceeds → cash" Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Top" Margin="0,2,10,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ProceedsText" TextWrapping="Wrap"
                       Foreground="#388E3C" VerticalAlignment="Center" />
        </Grid>
    </DockPanel>
</Window>
