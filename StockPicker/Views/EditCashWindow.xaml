<Window x:Class="StockPicker.Views.EditCashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Cash Balance"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="18,6" Margin="0,0,8,0" />
            <Button Content="Set"    Click="Set_Click" IsDefault="True" Padding="18,6" />
        </StackPanel>

        <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                       Text="Directly set the cash balance for correction or testing. This overrides the number and is NOT recorded as a deposit/withdrawal in the transaction history." />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Cash balance  $" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBox x:Name="CashBox" Width="140" VerticalContentAlignment="Center" Padding="4,3"
                         ToolTip="New cash balance" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
