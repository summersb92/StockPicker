<Window x:Class="StockPicker.Views.TransactionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transaction History"
        Width="760" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="12">
        <!-- Summary strip -->
        <Border DockPanel.Dock="Top" Background="#F5F7FA" BorderBrush="#DDE3EA"
                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#456" />
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Close" IsCancel="True" Padding="18,6" />
        </StackPanel>

        <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F7F7F7" CanUserSortColumns="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Type}" Value="Buy">
                            <Setter Property="Background" Value="#EEF3FB" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="Sell">
                            <Setter Property="Background" Value="#E8F5E9" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="Withdrawal">
                            <Setter Property="Background" Value="#FFF3E0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date"     Binding="{Binding DateDisplay}"   Width="110" SortMemberPath="Date" />
                <DataGridTextColumn Header="Type"     Binding="{Binding TypeDisplay}"   Width="90" />
                <DataGridTextColumn Header="Symbol"   Binding="{Binding Symbol}"        Width="70" />
                <DataGridTextColumn Header="Detail"   Binding="{Binding DetailDisplay}" Width="170" />
                <DataGridTextColumn Header="Value"    Binding="{Binding GrossDisplay}"  Width="90" />
                <DataGridTextColumn Header="Cash"     Binding="{Binding CashDeltaDisplay}" Width="100" SortMemberPath="CashDelta" />
                <DataGridTextColumn Header="Realized" Binding="{Binding RealizedGainDisplay}" Width="100" SortMemberPath="RealizedGain" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
