<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StockPicker.Desktop.Views.SellPositionWindow"
        Title="Sell Position"
        Width="400" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- MIGRATION NOTE: WPF keyed FieldLabel + implicit TextBox/DatePicker styles →
         window-scoped Avalonia styles. -->
    <Window.Styles>
        <Style Selector="TextBlock.field">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="DatePicker">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0" Spacing="8">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="18,6" />
            <Button Content="Sell" Classes="accent" Click="Sell_Click" IsDefault="True" Padding="18,6" />
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#C0392B" IsVisible="False"
                       TextWrapping="Wrap" Margin="0,0,0,8" />

            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Symbol"      Classes="field" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SymbolText" VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Shares"      Classes="field" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SharesText" VerticalAlignment="Center"
                           Margin="0,0,0,8" />

                <!-- Label carries the Glossary "Price" tooltip (set in the constructor);
                     the input box keeps its task-specific hint. -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sell price"  Classes="field"
                           x:Name="SellPriceLabel" />
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PriceBox"
                           TextChanged="PriceBox_TextChanged"
                           ToolTip.Tip="Price per share you're selling at (defaults to the latest price)." />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Sell date"   Classes="field" />
                <DatePicker Grid.Row="3" Grid.Column="1" x:Name="SellDatePicker" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Proceeds → cash" Classes="field"
                           VerticalAlignment="Top" Margin="0,2,10,0" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ProceedsText" TextWrapping="Wrap"
                           Foreground="#388E3C" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
