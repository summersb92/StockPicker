<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StockPicker.Desktop.ViewModels"
        x:Class="StockPicker.Desktop.Views.GlossaryWindow"
        x:DataType="vm:GlossaryViewModel"
        Title="Glossary — Terms &amp; Metrics"
        Width="640" Height="720"
        MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="14">
        <!-- Header + live search -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Glossary" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Definitions for every metric, signal, and strategy the app uses. Educational only — not investment advice."
                       Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8" />
            <TextBox Text="{Binding SearchText}"
                     Watermark="🔎  Search terms, keys, or descriptions…" />
        </StackPanel>

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Classes="accent" Click="Close_Click"
                    IsCancel="True" IsDefault="True" Padding="18,6" />
        </StackPanel>

        <!-- Scrollable, category-grouped term list -->
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GlossaryGroupViewModel">
                            <HeaderedContentControl Classes="card"
                                                    Header="{Binding HeaderDisplay}"
                                                    Margin="0,0,0,10">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GlossaryItemViewModel">
                                            <Border BorderBrush="{StaticResource App.BorderSoftBrush}"
                                                    BorderThickness="0,0,0,1" Padding="0,7">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Term}"
                                                                   FontWeight="Bold" FontSize="13"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="{StaticResource App.AccentSoftBrush}"
                                                                CornerRadius="3" Padding="5,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CategoryLabel}"
                                                                       FontSize="9.5"
                                                                       Foreground="{StaticResource App.AccentDarkBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Explanation}"
                                                               TextWrapping="Wrap"
                                                               Foreground="#444" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding FormulaDisplay}"
                                                               IsVisible="{Binding HasFormula}"
                                                               FontFamily="Consolas, Menlo, monospace"
                                                               FontSize="11" Foreground="#666"
                                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding RangeDisplay}"
                                                               IsVisible="{Binding HasRange}"
                                                               FontSize="11" Foreground="#666"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </HeaderedContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <TextBlock Text="No terms match your search."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#999" FontStyle="Italic" FontSize="13"
                       IsHitTestVisible="False"
                       IsVisible="{Binding !HasResults}" />
        </Grid>
    </DockPanel>
</Window>
